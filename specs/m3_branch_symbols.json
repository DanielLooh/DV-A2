{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Australia’s bank branches are",
    "subtitle": "Branches per quarter-degree square (about 25 km).",
    "anchor": "start",
    "fontSize": 15,
    "fontWeight": 600,
    "subtitleFontSize": 12,
    "subtitleColor": "#4C6074",
    "color": "#12263A"
  },
  "width": 600,
  "height": 520,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Public Sans",
    "legend": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "labelColor": "#12263A",
      "titleColor": "#12263A",
      "titleFontWeight": 600
    },
    "title": {
      "font": "Public Sans",
      "color": "#12263A"
    }
  },
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": 860,
    "translate": [
      300.0,
      255.0
    ]
  },
  "params": [
    {
      "name": "year",
      "value": 2026,
      "bind": {
        "input": "radio",
        "options": [
          2017,
          2026
        ],
        "name": "Year: ",
        "inline": true
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/geography/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E4EAEF",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/derived/m3_branch_cells.csv",
        "format": {
          "parse": {
            "year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == year"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#12263A",
        "fillOpacity": 0.55,
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "branches",
          "type": "quantitative",
          "title": "Branches in the square",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              487
            ],
            "range": [
              0,
              1300
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "values": [
              1,
              25,
              100,
              400
            ],
            "rowPadding": 4,
            "titlePadding": 6,
            "offset": -4
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "branches",
            "type": "quantitative",
            "title": "Branches in this square",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 150.1,
            "lat": -35.4,
            "label": "Sydney"
          },
          {
            "lon": 143.6,
            "lat": -38.1,
            "label": "Melbourne"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Public Sans",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#4C6074",
        "align": "right",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
